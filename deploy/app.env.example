# deploy/app.env — the runtime environment for the Next.js container.
# Mode 600, never committed.
#
# The fastest way to fill this in is to pull the live values from Vercel and
# then edit the three Supabase lines:
#
#   vercel env pull deploy/app.env --environment=production
#   chmod 600 deploy/app.env
#
# That command writes real secrets to disk. Run it yourself, on your machine,
# and keep the file out of git.

# ── Supabase (values change on the VPS) ─────────────────────────────────────
# Must be the public API name: NEXT_PUBLIC_* is inlined into the client bundle.
NEXT_PUBLIC_SUPABASE_URL=https://api.herbally.app
# Both must equal the corresponding values in deploy/.env. Note there is no
# such thing as an inline comment in an env file — anything after the value is
# part of the value, which is exactly how a key ends up with a trailing
# "# ANON_KEY from deploy/.env" and every request 401s.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://herbally.app
NEXT_PUBLIC_APP_NAME=HerbWise
REVALIDATE_SECRET=

# Caddy is the only thing in front of the app, so its X-Forwarded-* headers
# are trustworthy. Without this the rate limiter sees every request as
# coming from the Docker bridge.
TRUST_PROXY_HEADERS=1

# One long-lived instance: in-memory limiting is correct and drops Upstash.
RATE_LIMIT_BACKEND=memory

# ── Stripe ──────────────────────────────────────────────────────────────────
# Re-point the webhook at https://herbally.app/api/webhooks/stripe and paste
# the new endpoint's signing secret here.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Sentry ──────────────────────────────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_ENVIRONMENT=production

# ── Ollama Cloud ────────────────────────────────────────────────────────────
OLLAMA_CLOUD_API_KEY=
OLLAMA_CLOUD_URL=https://ollama.com/v1
OLLAMA_CLOUD_MODEL=deepseek-v4.1-flash

# ── Zoho Mail ───────────────────────────────────────────────────────────────
ZOHO_SMTP_HOST=
ZOHO_SMTP_PORT=
ZOHO_SMTP_USER=
ZOHO_SMTP_PASSWORD=
NEWSLETTER_FROM=

# ── External APIs ───────────────────────────────────────────────────────────
OPENFDA_BASE_URL=https://api.fda.gov
RXNORM_BASE_URL=https://rxnav.nlm.nih.gov/REST
PUBCHEM_BASE_URL=https://pubchem.ncbi.nlm.nih.gov/rest/pug

# ── Ads (leave unset: ads are off) ──────────────────────────────────────────
# NEXT_PUBLIC_ADSENSE_CLIENT=
# NEXT_PUBLIC_ADSENSE_SLOT_HERB=

# ── Optional tuning (defaults are fine) ─────────────────────────────────────
# SUPABASE_FETCH_TIMEOUT_MS=
# CHAT_DB_TIMEOUT_MS=
# CHAT_STREAM_IDLE_TIMEOUT_MS=
