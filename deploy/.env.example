# deploy/.env — secrets for the database/auth containers only.
# Compose reads this automatically. Mode 600. Never commit it.
#
#   cp deploy/.env.example deploy/.env
#   chmod 600 deploy/.env
#   openssl rand -hex 24                  → POSTGRES_PASSWORD
#   node deploy/gen-keys.mjs -o deploy/.env   → JWT_SECRET, ANON_KEY, SERVICE_ROLE_KEY

POSTGRES_PASSWORD=

# Minted by gen-keys.mjs. Must be identical in deploy/app.env.
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=

# Token lifetime handed to signed-in users, in seconds.
JWT_EXPIRY=3600

# Transactional mail — same mailbox the hosted project used.
# Copy the values out of Vercel Production; do not guess them.
SMTP_ADMIN_EMAIL=info@herbally.app
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=HerbAlly

# Build inputs that are not secrets.
NEXT_PUBLIC_APP_NAME=HerbWise
NEXT_PUBLIC_SENTRY_DSN=

# Set by CI to the pushed image tag; leave alone for a local build.
APP_IMAGE=
