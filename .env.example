# ===========================================
# HerbAlly Environment Variables
# ===========================================
# Copy this file to .env.local or .env and fill in your values
# NEVER commit .env files with real secrets to git!

# ===========================================
# Required - App Configuration
# ===========================================

# Public URL of your app (used for absolute URLs, sitemap, etc.)
NEXT_PUBLIC_APP_URL=https://your-domain.com

# App name (shown in UI)
NEXT_PUBLIC_APP_NAME=HerbAlly

# ===========================================
# Required - Supabase (Database + Auth)
# ===========================================

# Get these from: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key (server-side only, keep secret!)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ===========================================
# AI Configuration - OpenRouter (recommended)
# ===========================================

# OpenRouter API (free models available)
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Default uses the OpenRouter free pool. The free pool rotates models and
# occasionally returns low-quality / hallucinated answers, which is risky for
# health content. For production traffic, set a stable paid model:
#   OPENROUTER_MODEL=openai/gpt-4o-mini        # ~$0.15/1M input, very stable
#   OPENROUTER_MODEL=anthropic/claude-3-haiku  # similar cost, structured-output friendly
# When OPENROUTER_MODEL is unset or 'openrouter/free' the route still uses the
# fallback chain in route.ts when the primary 5xx/404s.
OPENROUTER_MODEL=openrouter/free

# ===========================================
# Required - Stripe (Donations)
# ===========================================

# Get keys from: https://dashboard.stripe.com/apikeys
# Use test keys for development, live keys for production
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Webhook secret (from Stripe Dashboard > Webhooks)
# Required for donation confirmation
STRIPE_WEBHOOK_SECRET=whsec_...

# ===========================================
# Optional - Rate Limiting (Production)
# ===========================================

# For serverless deployments, use Upstash Redis
# Get credentials from: https://upstash.com
RATE_LIMIT_BACKEND=upstash
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token-here

# ===========================================
# Optional - Error Tracking (Sentry)
# ===========================================

# Get DSN from: https://sentry.io/settings/<org>/projects/<project>/keys/
SENTRY_DSN=https://xxx@sentry.io/xxx
NEXT_PUBLIC_SENTRY_DSN=https://xxx@sentry.io/xxx
SENTRY_ORG=your-org
SENTRY_PROJECT=your-project
# Generate auth token at: https://sentry.io/settings/account/api/auth-tokens/
# Requires: project:releases, project:read, org:read
SENTRY_AUTH_TOKEN=your-auth-token

# ===========================================
# Optional - Analytics (Vercel/Plausible)
# ===========================================

# Next.js built-in analytics (if deploying to Vercel)
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=your-vercel-analytics-id

# Or Plausible (self-hosted or cloud)
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=your-domain.com

# ===========================================
# Optional - External APIs
# ===========================================

# RxNorm API (defaults to public endpoint)
RXNORM_BASE_URL=https://rxnav.nlm.nih.gov/REST

# OpenFDA API (defaults to public endpoint)
OPENFDA_BASE_URL=https://api.fda.gov/drug

# ===========================================
# Deployment Specific
# ===========================================

# Node environment (production/development/test)
# NODE_ENV=production
